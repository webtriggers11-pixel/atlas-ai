# Copy to backend/.env and fill in. Never commit the real .env.

# Local Docker Postgres (docker-compose.yml overrides this inside the backend container)
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/atlas_db
REDIS_URL=redis://localhost:6379

# Which LLM to use by default: ollama | groq | gemini
LLM_PROVIDER=ollama

# Ollama (local, free, private) — no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (free tier) — https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google; don't send confidential documents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CORS_ORIGINS=http://localhost:5173
PORT=8000

# Keep false. Schema changes are applied explicitly (see idea-atlas-docs/adr/ADR-001).
AUTO_MIGRATE=false

# Best chunk similarity below this marks a node as under-documented
GAP_THRESHOLD=0.35

# ── V2 retrieval (defaults chosen by evaluation — see idea-atlas-docs/v2/EVAL_RESULTS.md) ──
EMBEDDING_PROVIDER=local
RETRIEVAL_MODE=vector          # vector | hybrid
QUERY_REWRITE=false
EVIDENCE_K=4

# ── V2 LLM reliability ──
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BUDGET_S=20               # interactive requests
LLM_BACKGROUND_RETRY_BUDGET_S=150   # extraction / analysis jobs
CLASSIFY_PROMPT=classify-v2

# ── Background jobs ──
CELERY_TASK_ALWAYS_EAGER=false      # true = run jobs inline (no Redis/worker needed for quick local tries)
